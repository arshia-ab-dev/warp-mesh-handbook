{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "warp-ep"
      },
      {
        "tag": "dns-direct",
        "type": "udp",
        "server": "1.1.1.1"
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "warp-ep",
      "address": [
        "YOUR_VIRTUAL_IPV4_HERE/32",
        "YOUR_VIRTUAL_IPV6_HERE/128"
      ],
      "private_key": "YOUR_PRIVATE_KEY_HERE",
      "mtu": 1280,
      "peers": [
        {
          "address": "CLEAN_WARP_ENDPOINT_IP",
          "port": 500,
          "public_key": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
          "allowed_ips": [
            "0.0.0.0/0",
            "::/0"
          ],
          "reserved": [0, 0, 0]
        }
      ]
    }
  ],
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": "dns-direct",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "route",
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "action": "route",
        "rule_set": "geoip-ir",
        "outbound": "direct"
      },
      {
        "action": "route",
        "rule_set": "geosite-ir",
        "outbound": "direct"
      }
    ],
    "final": "warp-ep",
    "auto_detect_interface": true
  }
}
