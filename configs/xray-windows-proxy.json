{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "hosts": {
      "geosite:category-ads-all": [
        "0.0.0.0",
        "::"
      ],
      "cloudflare-dns.com": [
        "2606:4700:4700::1111",
        "2606:4700:4700::1001",
        "1.1.1.1",
        "1.0.0.1"
      ]
    },
    "servers": [
      {
        "address": "217.218.127.127",
        "port": 53,
        "network": "udp",
        "domains": [
          "geosite:ir",
          "domain:ir"
        ],
        "expectIPs": [
          "geoip:ir"
        ],
        "skipFallback": true
      },
      {
        "address": "192.168.1.1",
        "port": 53,
        "network": "udp",
        "domains": [
          "geosite:private",
          "domain:local",
          "domain:lan",
          "domain:home.arpa"
        ],
        "expectIPs": [
          "geoip:private"
        ],
        "skipFallback": true
      },
      "https://cloudflare-dns.com/dns-query",
      "2606:4700:4700::1111",
      "2606:4700:4700::1001",
      "1.1.1.1",
      "1.0.0.1"
    ],
    "queryStrategy": "UseIPv6v4"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "port": 1080,
      "listen": "::",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    },
    {
      "tag": "http-in",
      "port": 1081,
      "listen": "::",
      "protocol": "http",
      "settings": {
        "auth": "noauth"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "warp-out",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "YOUR_PRIVATE_KEY_HERE",
        "address": [
          "YOUR_VIRTUAL_IPV6_HERE/128",
          "YOUR_VIRTUAL_IPV4_HERE/32"
        ],
        "reserved": [0, 0, 0],
        "mtu": 1280,
        "noKernelTun": true,
        "peers": [
          {
            "endpoint": "CLEAN_WARP_ENDPOINT_IP:PORT",
            "publicKey": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
            "keepAlive": 5
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "udp-noise",
          "domainStrategy": "UseIPv6v4"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv6v4"
      },
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv6v4"
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    },
    {
      "tag": "udp-noise",
      "protocol": "freedom",
      "settings": {
        "noises": [
          { "type": "rand", "packet": "50-100", "delay": "1-5" },
          { "type": "rand", "packet": "50-100", "delay": "1-5" },
          { "type": "rand", "packet": "50-100", "delay": "1-5" },
          { "type": "rand", "packet": "50-100", "delay": "1-5" },
          { "type": "rand", "packet": "50-100", "delay": "1-5" }
        ]
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "outboundTag": "block",
        "domain": [
          "geosite:category-ads-all"
        ]
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "ip": [
          "217.218.127.127",
          "192.168.1.1"
        ],
        "port": "53"
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "ip": [
          "geoip:private",
          "geoip:ir"
        ]
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "domain": [
          "geosite:ir",
          "domain:ir",
          "geosite:private",
          "domain:local",
          "domain:lan",
          "domain:home.arpa"
        ]
      },
      {
        "type": "field",
        "inboundTag": ["socks-in", "http-in"],
        "outboundTag": "warp-out"
      }
    ]
  }
}
