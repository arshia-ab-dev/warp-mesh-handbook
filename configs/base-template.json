{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "hosts": {
      "geosite:category-ads-all": [
        "0.0.0.0",
        "::"
      ],
      "cloudflare-dns.com": [
        "2606:4700:4700::1111",
        "2606:4700:4700::1001",
        "1.1.1.1",
        "1.0.0.1"
      ]
    },
    "servers": [
      {
        "address": "217.218.127.127",
        "port": 53,
        "network": "udp",
        "domains": [
          "geosite:ir",
          "domain:ir"
        ],
        "expectIPs": [
          "geoip:ir"
        ],
        "skipFallback": true
      },
      {
        "address": "192.168.1.1",
        "port": 53,
        "network": "udp",
        "domains": [
          "geosite:private",
          "domain:local",
          "domain:lan",
          "domain:home.arpa"
        ],
        "expectIPs": [
          "geoip:private"
        ],
        "skipFallback": true
      },
      "https://cloudflare-dns.com/dns-query",
      "2606:4700:4700::1111",
      "2606:4700:4700::1001",
      "1.1.1.1",
      "1.0.0.1"
    ],
    "queryStrategy": "UseIPv6v4"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "port": 0,
      "protocol": "tun",
      "settings": {
        "name": "CloudflareMesh",
        "desc": "Wintun",
        "mtu": 1280,
        "gateway": [
          "YOUR_VIRTUAL_IPV6_HERE/128",
          "YOUR_VIRTUAL_IPV4_HERE/32"
        ],
        "dns": [
          "::1",
          "127.0.0.1"
        ],
        "autoSystemRoutingTable": [
          "::/0",
          "0.0.0.0/0"
        ],
        "autoOutboundsInterface": "auto"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    },
    {
      "tag": "dns-in-v4",
      "port": 53,
      "listen": "127.0.0.1",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1",
        "port": 53,
        "network": "tcp,udp"
      }
    },
    {
      "tag": "dns-in-v6",
      "port": 53,
      "listen": "::1",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "::1",
        "port": 53,
        "network": "tcp,udp"
      }
    },
    {
      "tag": "socks-in",
      "port": 1080,
      "listen": "::",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    },
    {
      "tag": "http-in",
      "port": 1081,
      "listen": "::",
      "protocol": "http",
      "settings": {
        "auth": "noauth"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    },
    {
      "tag": "socks1-in",
      "port": 1082,
      "listen": "::",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    },
    {
      "tag": "http1-in",
      "port": 1083,
      "listen": "::",
      "protocol": "http",
      "settings": {
        "auth": "noauth"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    },
    {
      "tag": "socks2-in",
      "port": 1084,
      "listen": "::",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    },
    {
      "tag": "http2-in",
      "port": 1085,
      "listen": "::",
      "protocol": "http",
      "settings": {
        "auth": "noauth"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "warp-out",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "YOUR_PRIVATE_KEY_HERE",
        "address": [
          "YOUR_VIRTUAL_IPV6_HERE/128",
          "YOUR_VIRTUAL_IPV4_HERE/32"
        ],
        "reserved": [0, 0, 0],
        "mtu": 1280,
        "noKernelTun": true,
        "peers": [
          {
            "endpoint": "CLEAN_WARP_ENDPOINT_IP:PORT",
            "publicKey": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
            "keepAlive": 5
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "udp-noise",
          "domainStrategy": "UseIPv6v4"
        }
      }
    },
    {
      "tag": "chain-socks-1",
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "SOCKS1_SERVER_IP_OR_DOMAIN",
            "port": 1080,
            "users": []
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "warp-out",
          "domainStrategy": "UseIPv6v4"
        }
      }
    },
    {
      "tag": "chain-socks-2",
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "SOCKS2_SERVER_IP_OR_DOMAIN",
            "port": 1080,
            "users": []
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "warp-out",
          "domainStrategy": "UseIPv6v4"
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns"
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {},
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv6v4"
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    },
    {
      "tag": "udp-noise",
      "protocol": "freedom",
      "settings": {
        "noises": [
          { "type": "rand", "packet": "50-100", "delay": "1-5" },
          { "type": "rand", "packet": "50-100", "delay": "1-5" },
          { "type": "rand", "packet": "50-100", "delay": "1-5" },
          { "type": "rand", "packet": "50-100", "delay": "1-5" },
          { "type": "rand", "packet": "50-100", "delay": "1-5" }
        ]
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "outboundTag": "block",
        "domain": [
          "geosite:category-ads-all"
        ]
      },
      {
        "type": "field",
        "inboundTag": ["dns-in-v4", "dns-in-v6"],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "ip": [
          "geoip:private",
          "geoip:ir"
        ]
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "domain": [
          "geosite:ir",
          "domain:ir",
          "geosite:private",
          "domain:local",
          "domain:lan",
          "domain:home.arpa"
        ]
      },
      {
        "type": "field",
        "inboundTag": ["socks1-in", "http1-in"],
        "outboundTag": "chain-socks-1"
      },
      {
        "type": "field",
        "inboundTag": ["socks2-in", "http2-in"],
        "outboundTag": "chain-socks-2"
      },
      {
        "type": "field",
        "outboundTag": "warp-out",
        "network": "tcp,udp"
      }
    ]
  }
}
